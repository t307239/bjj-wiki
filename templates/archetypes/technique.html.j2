{#
  technique.html.j2 — Technique archetype master template (REF-2 W1, z255oo)

  Renders a full Technique page with:
    - <head> with all SEO metadata (Article + BreadcrumbList + FAQPage + HowTo JSON-LD)
    - Article header (badge / belt / h1 / difficulty / belt-guide-box / intro paragraphs)
    - TOC widget (auto-generated by JS from h2 headings)
    - Content sections (variable count, each with heading + ol/ul card)
    - Related Video section (YouTube search button + UGC fallback CTA)
    - Athletes section (Elite athletes who use this technique)
    - Cross-link banners (Competition Rules, Training Safety)
    - Yoga + Gear boxes
    - FAQ section (Q&A list)
    - Related Techniques grid
    - Beehiiv newsletter signup
    - Dig Deeper semantic linking section
    - Dynamic CTA banner
    - Share bar (X / Reddit / Copy / YouTube)
    - z243-bottom-cta marker + CTA (per Marker Contract: WIKI_TEMPLATES.md)
    - Footer + back-to-top + auto-TOC script
    - z243-float-cta marker + floating CTA + script

  Inputs:
    page  — page-specific data dict (slug, title, h1, sections, athletes, faq, etc.)
    t     — locale messages dict (loaded from messages/<lang>.yml)
    lang  — locale code ('en' / 'ja' / 'pt')

  Output: byte-equivalent (or near) to current generate_bjj_wiki.py +
          patch_funnel_cta.py output for the same data.

  Marker Contract compliance (WIKI_TEMPLATES.md §HTML Marker Contract):
    - z243-bottom-cta: footer 直前
    - z243-float-cta: </body> 直前
    - format: <!-- z\d{3,}-[\w-]+ --> + 同行/改行 後の対応要素
    - idempotency: caller (renderer / patch_funnel_cta) responsibility
#}<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://pagead2.googlesyndication.com">
<link rel="preconnect" href="https://www.googletagmanager.com">
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="dns-prefetch" href="https://www.google-analytics.com">
<title>{{ page.seo_title }}</title>
<meta name="description" content="{{ page.description }}">
{#- z255eee: meta keywords は Google 2009 から ignore (z255nnn lint で永久削除済)。
    template でも出力しない。 -#}
<meta property="og:title" content="{{ page.og_title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ t.site.brand_suffix }}">
<meta property="og:url" content="{{ t.site.base_url }}/{{ lang }}/{{ page.slug }}.html">
<meta property="og:image" content="{{ t.site.app_url }}/api/og?mode=technique&category=technique&title={{ page.og_image_title }}&lang={{ lang }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ t.site.twitter_handle }}">
<meta name="twitter:title" content="{{ page.og_title }}">
<meta name="twitter:description" content="{{ page.description }}">
<meta name="twitter:image" content="{{ t.site.app_url }}/api/og?mode=technique&category=technique&title={{ page.og_image_title }}&lang={{ lang }}">
<link rel="canonical" href="{{ t.site.base_url }}/{{ lang }}/{{ page.slug }}.html">
<link rel="alternate" hreflang="x-default" href="{{ t.site.base_url }}/en/{{ page.slug }}.html">
<link rel="alternate" hreflang="en" href="{{ t.site.base_url }}/en/{{ page.slug }}.html">
<link rel="alternate" hreflang="ja" href="{{ t.site.base_url }}/ja/{{ page.slug }}.html">
<link rel="alternate" hreflang="pt" href="{{ t.site.base_url }}/pt/{{ page.slug }}.html">
<link rel="icon" href="{{ t.site.base_url }}/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ t.site.base_url }}/og-image.svg">
<link rel="stylesheet" href="/wiki-v2.css">
<script async src="https://www.googletagmanager.com/gtag/js?id={{ t.site.ga_id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','{{ t.site.ga_id }}');</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ t.site.adsense_client }}" crossorigin="anonymous"></script>
{%- if page.jsonld_article is defined %}
<script type="application/ld+json">{{ page.jsonld_article | safe }}</script>
{%- endif %}
{%- if page.jsonld_breadcrumb is defined %}
<script type="application/ld+json">{{ page.jsonld_breadcrumb | safe }}</script>
{%- endif %}
{%- if page.jsonld_faq is defined %}
<script type="application/ld+json">
{{ page.jsonld_faq | safe }}
</script>
{%- endif %}
{%- if page.jsonld_howto is defined %}
<script type="application/ld+json">
{{ page.jsonld_howto | safe }}
</script>
{%- endif %}
{%- if page.video_embed_id is defined %}
<style>
  /* YouTube embed */
  .yt-wrap{background:var(--card);border:1px solid var(--border);
    border-radius:14px;padding:24px;margin-bottom:8px}
  .yt-label{font-size:0.82rem;font-weight:700;color:var(--muted);
    text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
  .yt-frame-wrap{position:relative;padding-bottom:56.25%;height:0;overflow:hidden;
    border-radius:10px}
  .yt-frame-wrap iframe{position:absolute;top:0;left:0;width:100%;height:100%}
</style>
{%- endif %}
</head>
<body>
<div id="read-progress"></div>
<div class="container">
  <header>
    <a href="../{{ lang }}/index.html" class="logo">{{ t.nav.home }}</a>
    <nav class="lang-nav"><a href="../en/{{ page.slug }}.html"{% if lang == 'en' %} class="active"{% endif %}>{{ t.nav.flag.en }}</a><a href="../ja/{{ page.slug }}.html"{% if lang == 'ja' %} class="active"{% endif %}>{{ t.nav.flag.ja }}</a><a href="../pt/{{ page.slug }}.html"{% if lang == 'pt' %} class="active"{% endif %}>{{ t.nav.flag.pt }}</a></nav>
  </header>

  <span class="badge">{{ t.category_label[page.category] if (t.category_label is defined and page.category in t.category_label) else page.category }}</span><br>
  <span class="belt belt-{{ page.belt_level | lower }}">{{ t.belt_label[page.belt_level] if (t.belt_label is defined and page.belt_level in t.belt_label) else page.belt_level }}</span>
  <h1>{{ page.h1 }}</h1>
  {%- if page.difficulty is defined %}
  <div class="difficulty-bar"><span class="diff-belt" style="background:{{ t.belt_guide_box[page.difficulty.belt | lower].color }};color:#fff">{{ t.diff_belt_label[page.difficulty.belt | lower] if (t.diff_belt_label is defined and (page.difficulty.belt | lower) in t.diff_belt_label) else page.difficulty.belt | upper }}</span><span class="diff-stars">{{ page.difficulty.stars }}</span><span class="diff-label">{{ t.diff_level_label[page.difficulty.label] if (t.diff_level_label is defined and page.difficulty.label in t.diff_level_label) else page.difficulty.label }}</span></div>
  {%- endif %}
  {%- if page.guide_belt is defined %}
  {%- set bg = t.belt_guide_box[page.guide_belt | lower] %}
  <div class="belt-guide-box" style="border:2px solid {{ bg.color }};border-radius:10px;padding:16px;margin:24px 0;background:#0f1420"><span style="background:{{ bg.color }};color:#fff;padding:4px 12px;border-radius:20px;font-size:.85em;font-weight:700">{{ bg.badge_text }}</span><br><a href="../{{ lang }}/{{ bg.cta_href }}" style="color:#e2b714;font-weight:600;text-decoration:none;margin-top:8px;display:inline-block">{{ bg.cta_text }}</a></div>
  {%- endif %}
  <p>{% for para in page.intro_paragraphs %}<p style="color:#c2c2d9;margin-bottom:10px">{{ para | safe }}</p>
{% endfor %}</p>

  <div id="toc" class="toc">
    <div class="toc-title">{{ t.toc.title }}</div>
    <ul class="toc-list" id="toc-list"></ul>
  </div>

{% for section in page.sections %}
  <h2{% if section.style is defined and section.style == 'warning' %} style="color:#fca5a5;border-left-color:#dc2626"{% endif %}>{{ section.heading | replace('&', '&amp;') }}</h2>
  <div class="card"{% if section.style is defined and section.style == 'warning' %} style="background:#1a0505;border-color:#dc262640"{% endif %}>{% if section.type == 'ol' %}<ol style="padding-left:20px;margin:8px 0">
{% for item in section['items'] %}<li style="color:#c2c2d9;margin-bottom:6px">{% if item.bold is defined %}<strong>{{ item.bold }}</strong>{% if item.text %} {% endif %}{% endif %}{{ item.text | safe }}</li>
{% endfor %}</ol>{% elif section.type == 'ul' %}<ul style="padding-left:20px;margin:8px 0">
{% for item in section['items'] %}<li style="color:#c2c2d9;margin-bottom:6px">{% if item.bold is defined %}<strong>{{ item.bold }}</strong>{% if item.text %} {% endif %}{% endif %}{{ item.text | safe }}</li>
{% endfor %}</ul>{% elif section.type == 'ul-multi' %}{% for group in section.groups %}<ul style="padding-left:20px;margin:8px 0">
<li style="color:#c2c2d9;margin-bottom:6px"><strong>{{ group.label }}</strong></li>
{% for item in group['items'] %}<li style="color:#c2c2d9;margin-bottom:6px">{% if item.bold is defined %}<strong>{{ item.bold }}</strong>{% if item.text %} {% endif %}{% endif %}{{ item.text | safe }}</li>
{% endfor %}</ul>
{% endfor %}{% elif section.type == 'table' %}<table style="width:100%;border-collapse:collapse;margin:8px 0">{% if section.headers is defined %}<thead><tr>{% for h in section.headers %}<th style="padding:8px;text-align:left;border-bottom:1px solid #2a2a4a;color:#c2c2d9">{{ h }}</th>{% endfor %}</tr></thead>{% endif %}<tbody>{% for row in section['items'] %}<tr>{% for cell in row %}<td style="padding:8px;border-bottom:1px solid #1a1a2a;color:#c2c2d9">{{ cell | safe }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>{% elif section.type == 'text' %}{% for para in section['items'] %}<p style="color:#c2c2d9;margin-bottom:10px">{{ para | safe }}</p>
{% endfor %}{% elif section.type == 'cards' %}<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:8px 0">{% for card in section['items'] %}<div style="background:#0f1420;border:1px solid #1f2840;border-radius:10px;padding:14px"><div style="font-weight:700;color:#7c6af7;margin-bottom:6px">{{ card.title }}</div>{% if card.subtitle is defined %}<div style="font-size:.82rem;color:#94a3b8;margin-bottom:8px">{{ card.subtitle }}</div>{% endif %}<p style="color:#c2c2d9;margin:0;font-size:.9rem">{{ card.body | safe }}</p></div>{% endfor %}</div>{% endif %}</div>

{% endfor %}
  <h2>{{ t.related_video.heading }}</h2>
  <div class="card" style="background:#0a0a1a;border-color:#3a3a6a">
    <p style="color:#9ca3af;font-size:.9rem;margin-bottom:12px">{{ t.related_video.intro }}</p>
    <a class="yt-search-btn" href="https://www.youtube.com/results?search_query={{ page.h1_simple | urlencode }}+BJJ+tutorial" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
      {{ t.related_video.search_btn.replace('{tech}', page.h1_simple) }}
    </a>
    <div style="margin-top:14px;padding:12px 16px;background:#0d2010;border:1px solid #22c55e40;border-radius:8px">
      <p style="color:#86efac;font-size:.85rem;margin:0">
        {{ t.related_video.ugc_prefix }}
        <a href="{{ t.related_video.ugc_cta_href }}?ref=wiki&page={{ page.slug }}-ugc" target="_blank" rel="noopener noreferrer" style="color:#4ade80;font-weight:700;text-decoration:none">{{ t.related_video.ugc_cta_text }}</a>
      </p>
    </div>
  </div>

{%- if page.athletes is defined and page.athletes %}
  <div class="athletes-section"><h2>{{ t.athletes.heading }}</h2><div class="athlete-chips">{% for ath in page.athletes %}<a class="athlete-chip" href="../{{ lang }}/{{ ath.slug }}.html"><span style="font-size:1.2rem">{{ ath.flag }}</span><span><strong style="display:block;font-size:.9rem">{{ ath.name }}</strong></span></a>{% endfor %}</div></div>
{%- endif %}

  <!-- Competition Rules cross-link -->
  <div style="background:#0d1a2e;border-left:4px solid #3a86ff;border-radius:8px;padding:1rem 1.2rem;margin:1.5rem 0">
    <p style="font-size:.9rem;font-weight:700;color:#93c5fd;margin-bottom:.6rem">{{ t.competition_box.heading }}</p>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap">
{%- for link in t.competition_box.links %}
      <a href="{{ link.href }}" style="background:#111827;border:1px solid #1e3a5f;border-radius:6px;padding:.5rem .9rem;color:#93c5fd;text-decoration:none;font-size:.82rem">{{ link.text }}</a>
{%- endfor %}
    </div>
  </div>
  <!-- Training Safety cross-link -->
  <div style="background:#1a0d2e;border-left:4px solid #ff6b6b;border-radius:8px;padding:14px 18px;margin:20px 0">
    <strong style="color:#ff6b6b;font-size:.9rem">{{ t.safety_box.heading }}</strong>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px">
{%- for link in t.safety_box.links %}
      <a href="{{ link.href }}" style="background:#2a1a3a;color:#fff;padding:6px 14px;border-radius:20px;text-decoration:none;font-size:.85rem">{{ link.text }}</a>
{%- endfor %}
    </div>
  </div>
  <!-- CTA: app registration only (CLAUDE.md: affiliate links prohibited) -->

{%- if page.yoga_poses is defined and page.yoga_poses %}
  <div class="yoga-box"><h3>{{ t.yoga_box.heading }}</h3><p>{{ t.yoga_box.intro }}</p><div class="yoga-chips">{% for yp in page.yoga_poses %}<a class="yoga-chip" href="https://t307239.github.io/yoga-wiki/{{ lang }}/{{ yp.slug }}.html" target="_blank" rel="noopener noreferrer">🧘 {{ yp.name }}</a>{% endfor %}</div></div>
{%- endif %}
  <div class="gear-box"><h3>{{ t.gear_box.heading }}</h3><div class="gear-links">{% for link in (page.gear_links if page.gear_links is defined else t.gear_box.default_links) %}<a class="gear-link" href="{{ link.href }}">{{ link.text }}</a>{% endfor %}</div></div>

{%- if page.faq is defined and page.faq %}
  <!-- FAQ Section (long-tail SEO) -->
  <div style="margin:32px 0">
    <h2>{{ t.faq.heading }}</h2>
{%- for q in page.faq %}
    <div class="faq"><div class="faq-q">Q: {{ q.question }}</div><p>{{ q.answer | safe }}</p></div>
{%- endfor %}
  </div>
{%- endif %}

{%- if page.related_techs is defined and page.related_techs %}
  <!-- Related Techniques Card Grid -->
  <div style="background:#0f1420;border:1px solid #1f2840;border-radius:12px;padding:24px;margin:32px 0">
    <h3 style="font-size:1rem;font-weight:700;color:#7c6af7;margin-bottom:16px">{{ t.related_techs.heading }}</h3>
    <div style="display:flex;flex-wrap:wrap;gap:8px">
{%- for rt in page.related_techs %}
      <a href="../{{ lang }}/{{ rt.slug }}.html">{{ rt.name }}</a>
{%- endfor %}
    </div>
  </div>
{%- endif %}

  <div class="beehiiv-wrap"><h3>{{ t.newsletter.heading }}</h3><p>{{ t.newsletter.body }}</p><a class="beehiiv-btn" href="{{ t.newsletter.cta_href }}" target="_blank" rel="noopener noreferrer">{{ t.newsletter.cta_text }}</a></div>

{%- if page.related_concepts is defined and page.related_concepts %}
  <!-- Semantic Dig Deeper -->
  <div style="background:var(--card,#18181b);border:1px solid var(--border,rgba(255,255,255,0.10));border-radius:12px;padding:20px 24px;margin:28px 0"><h3 style="font-size:.9rem;font-weight:700;color:var(--accent,#7c3aed);margin-bottom:6px">{{ t.dig_deeper.heading }}</h3><p style="font-size:.8rem;color:var(--muted,#64748b);margin-bottom:14px">{{ t.dig_deeper.subtitle.replace('{tech}', page.h1_simple) }}</p><div style="display:flex;flex-wrap:wrap;gap:8px">{% for rc in page.related_concepts %}<a href="../{{ lang }}/{{ rc.slug }}.html" style="display:inline-block;background:var(--card,#18181b);border:1px solid var(--border,rgba(255,255,255,0.10));border-radius:8px;padding:8px 14px;color:var(--accent,#7c3aed);text-decoration:none;font-size:.85rem;font-weight:600">{{ rc.name }} →</a>{% endfor %}</div></div>
{%- endif %}

  <!-- Dynamic Contextual CTA Banner -->
  <div style="background:var(--card,#18181b);border:1px solid rgba(233,69,96,0.3);border-radius:12px;padding:20px 24px;margin:32px 0;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
    <div>
      <p style="margin:0 0 4px;font-size:.95rem;font-weight:700;color:#e2e2ee">{{ t.cta_dynamic.heading.replace('{tech}', page.h1_simple) }}</p>
      <p style="margin:0;font-size:.82rem;color:#7a7a9a">{{ t.cta_dynamic.body }}</p>
    </div>
    <a href="{{ t.site.app_url }}/login?ref=wiki&page={{ page.slug }}-dynamic" target="_blank" rel="noopener noreferrer" onclick="gtag&&gtag('event','app_cta_click',{page:location.pathname,lang:'{{ lang }}',tech:'{{ page.slug }}'})" style="flex-shrink:0;background:var(--accent2,#e94560);color:#fff;padding:10px 20px;border-radius:8px;text-decoration:none;font-size:.85rem;font-weight:700;white-space:nowrap">{{ t.cta_dynamic.cta_text }}</a>
  </div>

  <!-- Share Bar -->

{%- if page.video_embed_id is defined %}
  <div class="yt-wrap">
    <h3 class="yt-label">{{ t.related_video.heading }}</h3>
    <div class="yt-frame-wrap">
      <iframe
        src="https://www.youtube.com/embed/{{ page.video_embed_id }}?rel=0&modestbranding=1"
        title="BJJ technique tutorial"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy">
      </iframe>
    </div>
  </div>
{%- endif %}
  <div class="share-bar">
    <p>{{ t.share_bar.heading }}</p>
    <div class="share-btns">
      <a class="share-btn x" href="https://twitter.com/intent/tweet?url={{ t.site.base_url }}/{{ lang }}/{{ page.slug }}.html&text={{ page.h1_simple | urlencode }}+%23BJJ+%23bjjwiki" target="_blank" rel="noopener noreferrer">{{ t.share_bar.x_btn }}</a>
      <a class="share-btn reddit" href="https://www.reddit.com/submit?url={{ t.site.base_url }}/{{ lang }}/{{ page.slug }}.html&title={{ page.h1_simple | urlencode }}" target="_blank" rel="noopener noreferrer">{{ t.share_bar.reddit_btn }}</a>
      <button class="share-btn copy" onclick="navigator.clipboard.writeText('{{ t.site.base_url }}/{{ lang }}/{{ page.slug }}.html').then(()=>{this.textContent='{{ t.share_bar.copy_btn_done }}';setTimeout(()=>this.textContent='{{ t.share_bar.copy_btn }}',2000)})">{{ t.share_bar.copy_btn }}</button>
      <a class="yt-search-btn" href="https://www.youtube.com/results?search_query={{ page.h1_simple | urlencode }}+BJJ+tutorial" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg> {{ t.share_bar.youtube_btn }}</a>
    </div>
  </div>

{%- if include_z243_cta %}
  <!-- z243-bottom-cta --><div class="z243-bottom-cta" style="margin:2rem 0;padding:24px 24px;background:linear-gradient(135deg,#0d2010 0%,#0a1a0d 100%);border:2px solid #2e7d32;border-radius:14px;text-align:center"><div style="font-weight:700;color:#a5d6a7;font-size:1.1rem;margin-bottom:6px">{{ t.cta_bottom.heading }}</div><div style="font-size:.9rem;color:#c8e6c9;margin-bottom:16px">{{ t.cta_bottom.body }}</div><a href="{{ t.site.app_url }}/login?ref=wiki&page=bottom" style="display:inline-block;background:#10B981;color:#fff;padding:12px 28px;border-radius:10px;text-decoration:none;font-weight:700;font-size:1rem" onclick="window.gtag&&gtag('event','wiki_cta_click',{position:'bottom',lang:'{{ lang }}'})">{{ t.cta_bottom.cta_text }}</a></div>
{%- endif %}
<footer>
    <p>{{ t.footer.tagline }}</p>
    <p style="margin-top:8px"><a href="{{ t.footer.privacy_href }}" style="color:var(--muted)">{{ t.footer.privacy_text }}</a></p>
  </footer>
</div>
  <button id="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>
  <script>
  (function(){
    var prog=document.getElementById('read-progress');
    var btn=document.getElementById('back-to-top');
    window.addEventListener('scroll',function(){
      var scrolled=window.scrollY;
      var total=document.body.scrollHeight-window.innerHeight;
      if(total>0){prog.style.width=(scrolled/total*100)+'%';}
      if(scrolled>300){btn.style.display='flex';}else{btn.style.display='none';}
    },{passive:true});
    var headings=document.querySelectorAll('h2');
    if(headings.length>=3){
      var tocEl=document.getElementById('toc');
      var listEl=document.getElementById('toc-list');
      if(tocEl&&listEl){
        headings.forEach(function(h,i){
          var id='section-'+i;
          h.id=id;
          var li=document.createElement('li');
          var a=document.createElement('a');
          a.href='#'+id;
          a.textContent=h.textContent;
          li.appendChild(a);
          listEl.appendChild(li);
        });
        tocEl.style.display='block';
      }
    }
  })();
  </script>
{%- if include_z243_cta %}
<!-- z243-float-cta --><div id="z243-float" style="position:fixed;bottom:20px;right:20px;max-width:280px;background:#0d2010;border:1px solid #2e7d32;border-radius:14px;padding:16px 18px;box-shadow:0 4px 20px rgba(0,200,83,.15);z-index:999;display:none;animation:slideUp .3s ease">
<button onclick="document.getElementById('z243-float').style.display='none';try{localStorage.setItem('z243_float_dismissed',Date.now())}catch(e){}" style="position:absolute;top:8px;right:12px;background:none;border:none;color:#546e7a;font-size:1rem;cursor:pointer;line-height:1" aria-label="Close">✕</button>
<div style="font-weight:700;color:#a5d6a7;margin-bottom:6px;font-size:.9rem">{{ t.cta_float.heading }}</div>
<p style="font-size:.8rem;color:#c8e6c9;margin:0 0 12px">{{ t.cta_float.body }}</p>
<a href="{{ t.site.app_url }}/login?ref=wiki&page=float" style="display:block;background:#10B981;color:#fff;padding:8px 16px;border-radius:8px;text-decoration:none;font-weight:700;font-size:.85rem;text-align:center" onclick="window.gtag&&gtag('event','wiki_cta_click',{position:'float',lang:'{{ lang }}'})">{{ t.cta_float.cta_text }}</a>
</div>
<style>@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}</style>
<script>(function(){
try{
  var d=localStorage.getItem('z243_float_dismissed');
  if(d && (Date.now()-parseInt(d,10))<7*86400000) return;
}catch(e){}
var el=document.getElementById('z243-float');
if(!el) return;
var shown=false;
function check(){if(shown) return; var sp=(window.scrollY/(document.documentElement.scrollHeight-window.innerHeight))*100; if(sp>=30){el.style.display='block';shown=true;window.removeEventListener('scroll',check);}}
window.addEventListener('scroll',check,{passive:true});
})();</script>
{%- endif %}
</body>
</html>
